# ===== PhishGuard 設定（複製為 .env 後修改）=====
# 所有參數皆為必填；清單以逗號分隔，可留空。系統環境變數會覆寫此檔。
# 相對路徑以專案根目錄為準。

# ---------- Ollama（本機 SLM）----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 運算裝置：auto = 有 GPU 用 GPU，沒有才用 CPU；gpu = 強制全部放 GPU；cpu = 強制只用 CPU
OLLAMA_DEVICE=auto
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
# 分段判讀：每段字數、相鄰段重疊字數、最多送幾段（超過時保留前 N-1 段與最後一段）
LLM_CHUNK_CHARS=2000
LLM_CHUNK_OVERLAP=200
LLM_MAX_CHUNKS=6
# 差異測試：移除可疑段落後，惡意 raw logit 上升超過此值即判定為「操控模型」
INJECTION_DIFF_THRESHOLD=3.0

# ---------- 標頭檢查（信任邊界）----------
# 我方收信伺服器（MX）主機名稱；Received 中「by 這些主機」的第一跳即為信任邊界。強烈建議設定。
MX_HOSTNAMES=
# 我方伺服器寫入 Authentication-Results 時的 authserv-id（該標頭第一個欄位）。強烈建議設定。
TRUSTED_AUTHSERV_IDS=
# 信任的 ARC 簽章者（轉寄/郵件論壇造成 DMARC fail 時，ARC 通過可降低扣分）
ARC_TRUSTED_SEALERS=google.com,microsoft.com,outlook.com,yahoo.com
# 受保護網域（偵測仿冒網域：同形字、拼字近似、品牌嵌入子網域）
PROTECTED_DOMAINS=paypal.com,apple.com,microsoft.com,google.com,ctbcbank.com,cathaybk.com.tw,esunbank.com.tw,post.gov.tw
# 品牌關鍵字:官方網域（多個網域以 | 分隔；未指定網域時以 PROTECTED_DOMAINS 為準）
BRAND_KEYWORDS=paypal:paypal.com,apple:apple.com|icloud.com,microsoft:microsoft.com|office.com|outlook.com,google:google.com|gmail.com,office365:microsoft.com|office.com,中國信託:ctbcbank.com,國泰:cathaybk.com.tw|cathaylife.com.tw,玉山:esunbank.com.tw|esunbank.com,中華郵政:post.gov.tw,國稅局:ntbt.gov.tw|mof.gov.tw
FREEMAIL_DOMAINS=gmail.com,outlook.com,hotmail.com,yahoo.com,yahoo.com.tw,163.com,qq.com,proton.me,protonmail.com,icloud.com

# ---------- 網址 ----------
# IP 白名單（單一 IP 或 CIDR）；連結直接寫 IP 且不在白名單 → 判定為惡意
IP_WHITELIST_FILE=data/ip_whitelist.txt
# 本機網址黑名單（網域或完整網址）
URL_BLOCKLIST_FILE=data/url_blocklist.txt
URL_SHORTENERS=bit.ly,tinyurl.com,t.co,goo.gl,is.gd,cutt.ly,rebrand.ly,shorturl.at,ow.ly,buff.ly,reurl.cc,ppt.cc,pse.is,lihi.cc,lihi1.com,lihi2.com,lihi3.com,0rz.tw,tiny.cc,s.id,rb.gy
SUSPICIOUS_TLDS=top,xyz,icu,cyou,click,link,live,buzz,rest,shop,monster,quest,sbs,cfd,lol,mom,zip,mov,gq,tk,ml,cf,ga

# ---------- 圖片 ----------
# 是否對圖片做 OCR（需安裝 rapidocr_onnxruntime）；QR Code 解析需安裝 opencv-python-headless
IMAGE_OCR=true

# ---------- 附件 ----------
# 本機已知惡意雜湊清單（不做任何外部查詢）
MALWARE_HASH_DB=data/malware_hashes.txt

# ---------- 判定與融合 ----------
# 決策門檻（calibrate 後會依 TARGET_RECALL 自動調整並寫入 CALIBRATION_FILE）
DECISION_THRESHOLD=0.3
# 校準時要達到的最低召回率（重視不漏抓）
TARGET_RECALL=0.98
# final_logit = BIAS + W_LLM*LLM校準logit + W_HEADER*標頭 + W_ATTACHMENT*附件 + W_URL*網址 + W_IMAGE*圖片 + W_INJECTION*注入
FUSION_BIAS=-1.0
FUSION_W_LLM=0.8
FUSION_W_HEADER=0.45
FUSION_W_ATTACHMENT=0.6
FUSION_W_URL=0.5
FUSION_W_IMAGE=0.5
FUSION_W_INJECTION=2.5
# 硬性下限：提示詞注入 / 附件命中已知惡意雜湊 / 連結直接使用非白名單 IP
INJECTION_MIN_PROB=0.85
KNOWN_MALWARE_MIN_PROB=0.99
IP_URL_MIN_PROB=0.99
# LLM Platt scaling 初始值 p = sigmoid(A*raw_logit + B)（calibrate 後被覆寫）
LLM_PLATT_A=0.35
LLM_PLATT_B=0.0
CALIBRATION_FILE=calibration.json

# ---------- 資料集（Kaggle: Phishing Email Dataset "Phish No More"）----------
DATASET_DIR=dataset
# phishing_email.csv 是其餘六檔的合併版（只有 text_combined），預設不用以免重複
DATASET_FILES=CEAS_08.csv,Enron.csv,Ling.csv,Nazario.csv,Nigerian_Fraud.csv,SpamAssasin.csv
# 每次抽樣總數（依來源檔 × 標記分層抽樣）；0 = 全部（LLM 很慢，不建議）
DATASET_SAMPLE_SIZE=1000
# 校準集比例，其餘為測試集（以內容雜湊固定切分，兩者不重疊）
DATASET_CAL_RATIO=0.5
DATASET_SEED=42
# 訓練集比例（0 = 不切訓練集）。要微調時建議 TRAIN=0.6、CAL=0.2，其餘 0.2 為測試集。
# 注意：調整比例會改變 cal / test 的組成，訓練後務必重新 calibrate 與 evaluate。
DATASET_TRAIN_RATIO=0.0

# ---------- 模型微調（LoRA / QLoRA，需 NVIDIA GPU）----------
# HuggingFace 模型名稱或本機路徑，需與推論模型同系列（Ollama 的 qwen2.5:7b ↔ Qwen/Qwen2.5-7B-Instruct）
# 6 GB VRAM（如筆電版 RTX 3060）建議改用 Qwen/Qwen2.5-3B-Instruct；7B 的 QLoRA 約需 8–10 GB
TRAIN_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
TRAIN_OUTPUT_DIR=models/finetune
# 從訓練集抽樣的信件數（每封會依 A/B 兩種選項順序各產生一筆訓練資料）；0 = 全部
TRAIN_SAMPLE_SIZE=4000
TRAIN_EPOCHS=1
TRAIN_LEARNING_RATE=0.0002
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
# 單筆訓練資料的 token 上限（過長的信件會截短內文）
TRAIN_MAX_SEQ_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.05
TRAIN_LOAD_IN_4BIT=true
# 注入擴增比例：對此比例的信件「額外」產生一份插入提示詞注入語句的版本（標記為惡意），原信保留
TRAIN_INJECTION_AUG=0.3
# 從訓練資料中保留做訓練期間驗證的比例
TRAIN_VAL_RATIO=0.05
# 匯出到 Ollama 的模型名稱與量化方式（q4_K_M / q8_0 / f16）
TRAIN_OLLAMA_NAME=phishguard-qwen2.5
TRAIN_OLLAMA_QUANTIZE=q4_K_M
# 選用：llama.cpp 原始碼目錄。Ollama 無法直接匯入時改用 llama.cpp 轉 GGUF
LLAMA_CPP_DIR=
